{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for AtlasEngine desktop",
  "remote": {
    "urls": [
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5173/*",
      "http://localhost:5173",
      "http://localhost:5173/*"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "keyring:default",
    "opener:allow-reveal-item-in-dir",
    "fs:default"
  ]
}

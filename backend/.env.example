# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Set ATLAS_DB_TYPE=sqlite to use SQLite (no PostgreSQL required)
# Set ATLAS_DB_TYPE=postgres (default) for PostgreSQL
ATLAS_DB_TYPE=postgres
DATABASE_URL=postgresql://atlasengine:password@localhost:5432/atlasengine
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlasengine
DB_USER=atlasengine
DB_PASSWORD=your_secure_password_here

# Redis Configuration (Build Queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_base64_32
JWT_EXPIRES_IN=7d

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub App Configuration
# Instructions: Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: Contents (read/write), Metadata (read)
# Required events: push, pull_request
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_CLIENT_ID=your_github_app_client_id_here
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret_here
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Encryption Key for Tokens (GitHub, Supabase, etc.)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here_generate_with_openssl_rand_base64_32

# Supabase Integration (optional)
# Users provide their own Personal Access Token via the Settings UI.
# No server-side Supabase credentials needed — tokens are encrypted with ENCRYPTION_KEY.

# Docker Configuration
# Linux/Mac: /var/run/docker.sock
# Windows:   //./pipe/docker_engine
DOCKER_SOCKET=/var/run/docker.sock
PROJECTS_DIR=/projects
DOCKER_NETWORK=atlasengine-internal

# Domain Configuration
DOMAIN=localhost
PREVIEW_DOMAIN_PATTERN=proj-{id}.localhost
ENABLE_SSL=false

# Container Limits (Default Quotas)
DEFAULT_CONTAINER_MEMORY=256m
DEFAULT_CONTAINER_CPU=0.25
DEFAULT_MAX_CONTAINERS=1

# Port Range for Preview Containers
PORT_RANGE_START=3001
PORT_RANGE_END=3100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=50

# Quota Defaults
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
DEFAULT_MONTHLY_COST_LIMIT=50
DEFAULT_REQUESTS_PER_HOUR=50

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Review Debug Capture (developer-only)
# When enabled, Atlas writes linter pre-pass JSON and the exact review prompt(s)
# to ./.artifacts/review-debug for matching projects.
# Examples:
#   ATLAS_REVIEW_DEBUG_CAPTURE=true
#   ATLAS_REVIEW_DEBUG_CAPTURE_PROJECTS=ProjectBlack
#   ATLAS_REVIEW_DEBUG_CAPTURE_DIR=/tmp/atlas-review-debug
# ATLAS_REVIEW_DEBUG_CAPTURE=false
# ATLAS_REVIEW_DEBUG_CAPTURE_PROJECTS=
# ATLAS_REVIEW_DEBUG_CAPTURE_DIR=

# CORS
CORS_ORIGIN=http://localhost:5173

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_here

# Default chat/build engine provider (optional, auto-detects if unset)
# Options: anthropic, openai, google, opencode
# DEFAULT_CHAT_PROVIDER=opencode

# Feature Flags
ENABLE_AUTH=true
ENABLE_QUOTAS=true
ENABLE_RATE_LIMITING=true
# Enable the AtlasEngine Builder (chat-to-app creation flow). Atlas Review-only
# builds should leave this unset/false. Matches frontend ENABLE_BUILDER flag.
ENABLE_BUILDER=false

# Atlas Hosting (Vercel Deployment)
# Get these from your Vercel team settings
VERCEL_TEAM_ID=team_your_vercel_team_id
VERCEL_TOKEN=your_vercel_api_token
ATLAS_HOSTING_ROOT_DOMAIN=atlasengine.dev
PUBLISH_MAX_PER_DAY=20
PUBLISH_CONCURRENCY=2
